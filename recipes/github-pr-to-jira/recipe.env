# Settings the handler reads (part 3). None of these is a secret; the Jira credentials are in the compose file.
# The Jira project the issues are created in, and the issue type.
JIRA_PROJECT=PROJ
JIRA_ISSUE_TYPE=Task
# Workflow transition ids. They differ per Jira project: list yours with GET /rest/api/3/issue/<KEY>/transitions.
# 11 and 31 are the ids the repository's mock Jira uses for "To Do" and "Done".
JIRA_TRANSITION_TODO=11
JIRA_TRANSITION_DONE=31
# Where the handler remembers which issue belongs to which pull request. A volume, so a restart keeps it.
PR_DB=/data/pr-issues.db
LOG_LEVEL=INFO
