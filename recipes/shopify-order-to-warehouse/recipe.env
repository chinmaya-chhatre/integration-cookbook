# Settings the handler reads (part 3). None of these is a secret; the warehouse credential is in the compose file.
# Only orders in one of these Shopify financial states are sent. "paid" is the safe default: pay-later and
# unpaid orders are acknowledged and skipped.
FULFIL_FINANCIAL_STATUSES=paid
# How long the handler waits for the warehouse before treating the call as failed (and asking for a retry).
WAREHOUSE_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
