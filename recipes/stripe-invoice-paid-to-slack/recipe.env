# Settings the handler reads (part 3). Thresholds are in major units of each currency, so USD:5000
# means $5,000.00 and JPY:750000 means ¥750,000. A currency not listed here never alerts.
INVOICE_THRESHOLDS=USD:5000,EUR:4500,GBP:4000,JPY:750000
# Remember this many Stripe event ids to ignore redeliveries.
DEDUPE_MEMORY=10000
LOG_LEVEL=INFO
